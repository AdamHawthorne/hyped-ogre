# Required
DISCORD_TOKEN=

# Hyped Discord configuration
HYPED_GUILD_ID=
ROLL_CHANNEL_ID=
HIGH_ROLLER_ROLE_ID=
FOREVER_ROLE_ID=
FLAMEBOARD_CHANNEL_ID=
FLAMEBOARD_THRESHOLD=3

# Bot settings
BOT_NAME=Hyped Ogre
BOT_TIMEZONE=Europe/London
DB_PATH=bot.db

# Optional local Hyped Guild Companion bridge (disabled until explicitly enabled)
HYPED_SYNC_ENABLED=false
HYPED_SYNC_SECRET=
HYPED_SYNC_GUILD_NAME=Hyped
HYPED_SYNC_BANK_CHANNEL_ID=
GUILD_SYNC_DB_PATH=guild_sync.db

# Private desktop control endpoint. It only creates an owner-only raid setup
# card in the existing private #ogre channel; the normal Discord post
# confirmation remains required. Requires HYPED_SYNC_ENABLED=true as well.
HYPED_CONTROL_ENABLED=false
HYPED_CONTROL_SECRET=

# Optional owner/admin commands
ADMIN_MODE=true
OWNER_ID=
ADMIN_GUILD_ID=

# Optional operational logging
ENABLE_COMMAND_LOGGING=true
OFFICE_LOG_CHANNEL_ID=1554621739017707591

# Polls use their own database and the private Ogre channel, separately from logs.
POLL_DB_PATH=polls.db
POLL_ADMIN_CHANNEL_ID=1564594901746716713

# Upstream optional web/listing integrations are disabled by default
ENABLE_WEBHOOK=false
BOTLIST_TOKEN=
TOPGG_TOKEN=
TOPGG_WEBHOOK_SECRET=
