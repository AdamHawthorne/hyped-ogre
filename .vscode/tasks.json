{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hyped Ogre: check dependencies",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "pip", "check"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Hyped Ogre: compile Python",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "compileall", "-q", "rollogre.py", "cogs", "hyped_ogre", "tests", "scripts"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Hyped Ogre: run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Hyped Ogre: local checks",
      "dependsOn": [
        "Hyped Ogre: check dependencies",
        "Hyped Ogre: compile Python",
        "Hyped Ogre: run tests"
      ],
      "dependsOrder": "sequence",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
